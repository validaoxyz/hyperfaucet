{
  "name": "@validao/hyperfaucet-server",
  "private": true,
  "version": "2.5.1",
  "description": "PoW Faucet Server",
  "main": "dist/app.js",
  "bin": "bundle/powfaucet.cjs",
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "tsc",
    "prebuild-client": "npm ci --prefix faucet-client --ignore-scripts --no-audit --no-fund",
    "build-client": "cd faucet-client && node build-client.js",
    "package-binaries": "node ./scripts/package-binaries.mjs",
    "package-binaries:prefetch": "node ./scripts/package-binaries.mjs prefetch",
    "package-binaries:offline": "node ./scripts/package-binaries.mjs build",
    "check-package-binaries": "node ./scripts/package-binaries.mjs check-reproducible",
    "check-pkg-base-integrity": "node ./scripts/check-pkg-base-integrity.mjs",
    "check-release-archives": "node ./scripts/check-release-archives.mjs",
    "test:hosting": "node --test ops/*.test.mjs",
    "stage:hosting-policy": "node ops/stage-runtime-policy.mjs",
    "start": "tsc && node dist/app.js",
    "bundle": "tsc && webpack --mode production",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && cp -r libs dist-test/ && cp -r static dist-test/ && NODE_OPTIONS='--experimental-vm-modules' NODE_NO_WARNINGS=1 npx mocha --exit 'dist-test/tests/**/*.js'",
    "test-coverage": "rm -rf dist-test && tsc -p tsconfig.test.json && cp -r libs dist-test/ && cp -r static dist-test/ && NODE_OPTIONS='--experimental-vm-modules' NODE_NO_WARNINGS=1 npx c8 --reporter=text --reporter=lcov npx mocha --exit 'dist-test/tests/**/*.js'"
  },
  "author": "ValiDAO (https://validao.xyz)",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/validaoxyz/hyperfaucet.git"
  },
  "pkg": {
    "scripts": "bundle/*.cjs",
    "assets": [
      "faucet-config.example.yaml",
      "static/**/*"
    ],
    "targets": [
      "node22.23.2-linux-x64",
      "node22.23.2-win-x64"
    ],
    "outputPath": "bin"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.3.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.1"
    },
    "adm-zip": "^0.6.0",
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5",
      "minimatch": "^10.2.4"
    }
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.22.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/chai": "^5.0.0",
    "@types/json-bigint": "^1.0.4",
    "@types/mocha": "^10.0.7",
    "@types/mysql": "^2.15.26",
    "@types/node-fetch": "^2.6.11",
    "@types/node-static": "^0.7.11",
    "@types/randombytes": "^2.0.3",
    "@types/sinon": "^22.0.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.5.12",
    "c8": "^12.0.0",
    "chai": "^6.0.1",
    "mocha": "^11.0.1",
    "mysql-memory-server": "^1.3.0",
    "nyc": "^18.0.0",
    "sinon": "^22.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "webpack": "^5.105.3",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "@brettz9/node-static": "^0.1.1",
    "@ethereumjs/common": "^10.0.0",
    "@ethereumjs/tx": "^10.0.0",
    "@types/node": "^26.0.0",
    "bignumber.js": "^11.0.0",
    "commander": "^15.0.0",
    "hcaptcha": "^0.2.0",
    "html-entities": "^2.5.2",
    "jose": "^6.2.3",
    "json-bigint": "^1.0.0",
    "mysql2": "^3.11.0",
    "node-fetch": "^3.3.2",
    "randombytes": "^2.1.0",
    "tiny-typed-emitter": "^2.1.0",
    "uuid": "^14.0.0",
    "web3": "^4.11.1",
    "web3-eth-ens": "^4.4.0",
    "web3-providers-ipc": "^4.0.7",
    "ws": "^8.18.0",
    "yaml": "^2.5.0"
  }
}
