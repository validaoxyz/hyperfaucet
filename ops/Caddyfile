{
	admin off
	auto_https disable_redirects
	servers :443 {
		# Source: https://www.cloudflare.com/ips/ (verified 2026-08-22).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
		timeouts {
			read_body 15s
			read_header 10s
			write 30s
			idle 2m
		}
		max_header_size 32KB
	}
}

{$HYPERFAUCET_HOST}:443 {
	tls /run/secrets/cloudflare_origin_cert /run/secrets/cloudflare_origin_key {
		client_auth {
			mode require_and_verify
			trust_pool file /run/secrets/cloudflare_aop_ca
		}
	}

	route {
		header {
			-Server
			-Via
			-X-Powered-By
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			Cache-Control "private, no-store"
			+Vary "Authorization"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		}

		import /run/secrets/caddy_basic_auth

		reverse_proxy app:8082 {
			header_up -Authorization
			header_up -Proxy-Authorization
			header_up -CF-Connecting-IP
			header_up -True-Client-IP
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto https
			header_up Host {host}
		}
	}

	handle_errors {
		header {
			Cache-Control "private, no-store"
			+Vary "Authorization"
		}
		respond "" {http.error.status_code}
	}

	log {
		output stdout
		format json
	}
}
